{
    "name": "dvsa/mot-doctrine-module",
    "description": "DVSA Doctrine Module",
    "type": "module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laminas/laminas-servicemanager": "^4.0",
        "doctrine/cache": "^2.2",
        "laminas/laminas-dependency-plugin": "^2.6.0",
        "ext-memcached": "^3.2",
        "symfony/cache": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.3",
        "captainhook/plugin-composer": "^5.3",
        "squizlabs/php_codesniffer": "^3.10",
        "vimeo/psalm": "^5.24",
        "dvsa/coding-standards": "^2.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "DvsaDoctrineModule\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "phpunit"
        ],
        "phpcs": [
            "./vendor/bin/phpcs ."
        ],
        "psalm": [
            "./vendor/bin/psalm"
        ],
        "phpstan":[
            "vendor/bin/phpstan analyse"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "laminas/laminas-dependency-plugin": true,
            "captainhook/plugin-composer": true
        }
    }
}
